{
  "name": "collaborative-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Collaborative Workspace - Fullstack MERN Developer Platform",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"npm run dev --workspace=collaborative-workspace-backend\" \"npm run dev --workspace=frontend\"",
    "dev:backend": "npm run dev --workspace=collaborative-workspace-backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "start": "npm run start --workspace=collaborative-workspace-backend",
    "build": "npm run build --workspace=frontend",
    "lint": "npm run lint --workspace=frontend",
    "test": "npm run test --workspace=collaborative-workspace-backend",
    "seed": "npm run seed --workspace=collaborative-workspace-backend",
    "migrate": "npm run migrate --workspace=collaborative-workspace-backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
