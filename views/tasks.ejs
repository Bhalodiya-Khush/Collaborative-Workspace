<%- include('partials/header', { title: 'Tasks', page: 'tasks', user }) %>
<h2>Tasks</h2>
<p>Track work across the projects you can access. Developers see their assigned tasks.</p>
<% if (['admin', 'project_manager'].includes(user.role)) { %>
  <section>
    <h3>Create a task</h3>
    <form id="taskForm" class="form-grid">
      <label>Project<select name="project" id="taskProject" required><option value="">Choose a project</option></select></label>
      <label>Task title<input name="title" maxlength="160" required placeholder="What needs to be done?"></label>
      <input id="taskWorkspace" name="workspace" type="hidden">
      <label class="form-wide">Description<textarea name="description"></textarea></label>
      <label>Assign to<select name="assignee" id="taskAssignee"><option value="">Unassigned</option></select></label>
      <label>Priority<select name="priority"><option>low</option><option selected>medium</option><option>high</option><option>critical</option></select></label>
      <label>Due date<input name="dueDate" type="date"></label>
      <button type="submit">Create task</button>
    </form>
    <form id="taskAssignForm" class="form-grid">
      <label>Task<select name="taskId" id="assignTask" required><option value="">Choose a task</option></select></label>
      <label>Developer<select name="assignee" id="assignDeveloper" required><option value="">Choose a task first</option></select></label>
      <button type="submit">Assign task</button>
    </form>
  </section>
<% } %>
<% if (['admin', 'project_manager', 'developer'].includes(user.role)) { %>
  <section>
    <h3>Update task progress</h3>
    <form id="taskUpdateForm" class="form-grid">
      <label>Task<select name="taskId" id="updateTask" required><option value="">Choose a task</option></select></label>
      <label>Status<select name="status"><option value="">Keep current status</option><option>todo</option><option>in_progress</option><option>in_review</option><% if (user.role !== 'developer') { %><option>completed</option><% } %><option>blocked</option></select></label>
      <label>Progress<input name="completionPercentage" type="number" min="0" max="100" placeholder="0–100%"></label>
      <button type="submit">Save task update</button>
    </form>
  </section>
<% } %>
<section>
  <h3>Find tasks</h3>
  <form id="taskFilterForm" class="form-grid">
    <label>Project<select name="projectId" id="filterTaskProject"><option value="">All accessible projects</option></select></label>
    <label>Status<select name="status"><option value="">All statuses</option><option>todo</option><option>in_progress</option><option>in_review</option><option>completed</option><option>blocked</option></select></label>
    <label>Priority<select name="priority"><option value="">All priorities</option><option>low</option><option>medium</option><option>high</option><option>critical</option></select></label>
    <label>Search<input name="search" placeholder="Search tasks"></label>
    <label>Due date<select name="due"><option value="">Any time</option><option value="upcoming">Due in 7 days</option><option value="overdue">Overdue</option><option value="none">No due date</option></select></label>
    <button type="submit">Apply filters</button>
  </form>
</section>
<% if (['admin', 'project_manager'].includes(user.role)) { %>
  <section><h3>Deadline reminders</h3><form id="deadlineAlertForm" class="form-grid"><label>Look ahead (days)<input name="days" type="number" min="0" max="30" value="2" required></label><button type="submit">Check deadlines</button></form></section>
<% } %>
<section><h3>Task list</h3><ul id="tasks" class="card-list"><li class="empty-state">Loading tasks...</li></ul></section>
<%- include('partials/footer') %>
