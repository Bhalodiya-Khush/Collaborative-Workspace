<%- include('partials/header', { title: 'Workspaces', page: 'workspaces', user }) %>
<h2>Workspaces</h2>
<p>Your workspaces and team membership, all in one place.</p>

<% if (user.role === 'admin') { %>
  <section>
    <h3>Create a workspace</h3>
    <form id="workspaceForm" class="form-grid">
      <label>Workspace name<input name="name" maxlength="100" required placeholder="e.g. Product Engineering"></label>
      <label>Description<input name="description" maxlength="500" placeholder="What will this team work on?"></label>
      <div class="form-wide">
        <label>Invite existing team members <span class="help">Choose people to add. You can also invite them later.</span></label>
        <div id="initialWorkspaceMembers" class="check-list"><p>Loading member directory...</p></div>
      </div>
      <p class="form-wide help">You’ll be the administrator for this workspace. Workspace data and project access are limited to the workspaces you administer.</p>
      <button type="submit">Create workspace</button>
    </form>
  </section>
  <section>
    <h3>Manage a workspace team</h3>
    <form id="memberForm" class="form-grid">
      <label>Workspace<select name="workspaceId" id="manageWorkspace" required><option value="">Loading your workspaces...</option></select></label>
      <label>Member to add<select name="userId" id="availableWorkspaceMember" required><option value="">Choose a workspace first</option></select></label>
      <button type="submit">Add member</button>
    </form>
    <form id="roleForm" class="form-grid">
      <label>Workspace<select name="roleWorkspaceId" id="roleWorkspace" required><option value="">Choose workspace</option></select></label>
      <label>Team member<select name="roleUserId" id="roleWorkspaceMember" required><option value="">Choose a workspace first</option></select></label>
      <label>Role<select name="role" required><option value="project_manager">Project manager</option><option value="developer">Developer</option><option value="viewer">Viewer</option></select></label>
      <button type="submit">Update team role</button>
    </form>
    <form id="removeWorkspaceMemberForm" class="form-grid">
      <label>Workspace<select name="workspaceId" id="removeMemberWorkspace" required><option value="">Choose a workspace</option></select></label>
      <label>Member to remove<select name="userId" id="removeWorkspaceMember" required><option value="">Choose a workspace first</option></select></label>
      <button type="submit" class="button-danger">Remove from workspace</button>
    </form>
    <form id="workspaceUpdateForm" class="form-grid">
      <label>Workspace<select name="workspaceId" id="updateWorkspace" required><option value="">Choose a workspace</option></select></label>
      <label>Workspace name<input name="name" placeholder="Leave blank to keep current"></label>
      <button type="submit">Save workspace</button>
    </form>
  </section>
<% } %>

<section>
  <div class="form-actions"><h3>My workspaces</h3><button id="refreshWorkspaces" class="button button-quiet" type="button">Refresh</button></div>
  <ul id="workspaces" class="card-list"><li class="empty-state">Loading workspaces...</li></ul>
</section>
<% if (user.role === 'admin') { %>
<section>
  <h3>Workspace activity</h3>
  <form id="activityForm" class="form-grid">
    <label>Workspace<select name="workspaceId" id="activityWorkspace" required><option value="">Choose workspace</option></select></label>
    <button type="submit">View recent activity</button>
  </form>
</section>
<% } %>
<%- include('partials/footer') %>
