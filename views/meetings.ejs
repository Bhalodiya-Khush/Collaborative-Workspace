<%- include('partials/header', { title: 'Meetings', page: 'meetings', user }) %>
<h2>Project team meetings</h2>
<% if (['admin', 'project_manager', 'developer'].includes(user.role)) { %>
  <section>
    <h3>Schedule a project meeting</h3>
    <form id="meetingForm">
      <p><label>Project<br><select id="meetingProject" name="project" required><option value="">Loading projects...</option></select></label></p>
      <input id="meetingWorkspace" name="workspace" type="hidden">
      <p><label>Meeting title<br><input name="title" maxlength="120" required></label></p>
      <p><label>Scheduled time<br><input name="scheduledAt" type="datetime-local" required></label></p>
      <p><label>Duration (minutes)<br><input name="durationMinutes" type="number" min="5" max="480" value="60" required></label></p>
      <p><label>Agenda<br><textarea name="agenda" maxlength="2000"></textarea></label></p>
      <button id="scheduleMeetingButton" type="submit" disabled>Choose a project with write access to schedule</button>
    </form>
  </section>
<% } %>
<section>
  <form id="meetingFilterForm">
    <label>Project<br><select id="meetingFilterProject" name="projectId" required><option value="">Loading projects...</option></select></label>
    <button type="submit">Load project meetings</button>
  </form>
  <ul id="meetings"><li>Select a project to load meetings.</li></ul>
</section>
<section id="liveMeeting" hidden>
  <h3 id="liveMeetingTitle">Live meeting</h3>
  <p id="meetingStatus" aria-live="polite"></p>
  <div>
    <video id="localMeetingVideo" autoplay muted playsinline width="320"></video>
    <div id="remoteMeetingVideos"></div>
  </div>
  <button id="toggleMeetingMic" type="button">Mute microphone</button>
  <button id="toggleMeetingCamera" type="button">Turn camera off</button>
  <button id="leaveMeeting" type="button">Leave meeting</button>
  <button id="endMeeting" type="button" hidden>End meeting</button>
</section>
<script>window.workspaceIceServers = <%- JSON.stringify(iceServers) %>;</script>
<script src="/socket.io/socket.io.js"></script>
<%- include('partials/footer') %>
