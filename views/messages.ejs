<%- include('partials/header', { title: 'Messages', page: 'messages', user }) %>
<h2>Project team chat</h2>
<% if (['admin', 'project_manager', 'developer'].includes(user.role)) { %>
  <section>
    <form id="projectChatSelectForm">
      <label>Project<br><select id="chatProject" name="projectId" required><option value="">Loading projects...</option></select></label>
      <button type="submit">Open team chat</button>
    </form>
  </section>
<% } %>
<section id="projectChatPanel" hidden>
  <h3 id="projectChatTitle">Project chat</h3>
  <p id="projectChatConnection" aria-live="polite"></p>
  <ul id="project-chat-messages" aria-live="polite"><li>Select a project to open its chat.</li></ul>
  <form id="projectChatForm">
    <label>Message<br><textarea name="content" maxlength="4000" required></textarea></label>
    <button type="submit">Send message</button>
  </form>
</section>
<script src="/socket.io/socket.io.js"></script>
<%- include('partials/footer') %>
