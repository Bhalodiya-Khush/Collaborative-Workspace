<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Sign in | Collaborative Workspace</title><link rel="stylesheet" href="/css/app.css"></head>
<body data-page="login">
  <main class="page-shell auth-shell">
    <section>
      <a class="brand" href="/login">Collaborative Workspace</a>
      <h2>Welcome back</h2>
      <p>Sign in to continue to your workspace and team projects.</p>
      <p id="message" aria-live="polite"></p>
      <form id="loginForm">
        <label>Email<input type="email" name="email" required autocomplete="username" placeholder="you@company.com"></label>
        <label>Password<input type="password" name="password" required autocomplete="current-password"></label>
        <button type="submit">Sign in</button>
      </form>
      <p>New to the team? <a href="/register">Create an account</a></p>
    </section>
  </main>
  <script src="/js/page-app.js" defer></script>
</body>
</html>
