<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Collaborative Workspace</title>
  <link rel="stylesheet" href="/css/app.css">
</head>
<body data-page="<%= page %>" data-role="<%= user.role %>" data-user-id="<%= user._id %>">
  <header class="site-header">
    <a class="brand" href="/dashboard">Collaborative Workspace</a>
    <div class="account"><span><%= user.fullName %></span><span class="role-badge"><%= user.role === 'admin' ? 'Workspace admin' : user.role.replace('_', ' ') %></span><button id="logoutButton" class="button button-quiet" type="button">Log out</button></div>
    <nav aria-label="Main navigation">
      <a href="/dashboard">Dashboard</a>
      <% if (user.role === 'admin') { %><a href="/workspaces">Workspaces</a><% } %>
      <a href="/projects">Projects</a><a href="/tasks">Tasks</a><a href="/submissions">Submissions</a>
      <% if (['admin', 'project_manager', 'developer'].includes(user.role)) { %><a href="/meetings">Meetings</a><a href="/messages">Team chat</a><% } %>
      <a href="/monitoring">Monitoring</a><a href="/reports">Reports</a><a href="/notifications">Notifications</a>
      <a href="/profile">Profile</a>
    </nav>
  </header>
  <main class="page-shell">
